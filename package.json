{
  "name": "pdf-desk",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "An offline, browser-based PDF page organiser for Windows.",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node server.mjs --open",
    "serve": "node server.mjs",
    "test": "node --test tests/core.test.mjs tests/pdf.test.mjs tests/server.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "vendor": "node scripts/vendor.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.6.205",
    "lucide": "1.8.0"
  },
  "devDependencies": { "playwright": "1.62.1" }
}
